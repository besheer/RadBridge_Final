{% extends "base.html" %}
{% block page_title %}{{'مساحة عمل الطبيب' if ui_lang=='ar' else 'Radiologist Workspace'}}{% endblock %}
{% block subtitle %}{{'الصور والتقارير فقط' if ui_lang=='ar' else 'Clinical worklist, images and reports only'}}{% endblock %}
{% block content %}
{% if system_health %}
<div class="panel ops-health-strip">
<div><small>PACS</small><b>{{'ONLINE' if system_health.pacs else 'OFFLINE'}}</b></div>
<div><small>Studies Today</small><b>{{system_health.studies_today}}</b></div>
<div><small>My Queue</small><b>{{system_health.my_queue}}</b></div>
<div><small>Open Cases I Can Take</small><b>{{system_health.open_allowed}}</b></div>
<div><small>Workflow Problems</small><b>{{system_health.problems}}</b></div>
</div>
{% endif %}

<form class="panel filterbar" method="get">
<input name="q" value="{{request.args.get('q','')}}" placeholder="Patient / Patient ID / Accession">
<select name="status"><option value="">All statuses</option>{% for s in ['ARRIVED','IN_PROGRESS','COMPLETED','IMAGES_RECEIVED','REPORTING','FINAL'] %}<option value="{{s}}">{{s}}</option>{% endfor %}</select>
<select name="modality"><option value="">All modalities</option>{% for m in ['CT','MR','DX','US','MG','RF','NM','PT'] %}<option value="{{m}}">{{m}}</option>{% endfor %}</select>
<button class="btn primary">Apply</button>
</form>
<div class="panel"><div class="table-wrap"><table>
<thead><tr><th>Patient</th><th>Accession</th><th>Exam</th><th>Status</th><th>Assigned Doctor</th><th>Actions</th></tr></thead>
<tbody>
{% for o in rows %}
<tr>
<td><b>{{o.patient.name}}</b><small>{{o.patient.patient_id}}</small></td>
<td>{{o.accession}}</td>
<td>{{o.proc.name_ar if ui_lang=='ar' and o.proc and o.proc.name_ar else (o.proc.name if o.proc else o.procedure)}}</td>
<td><span class="badge">{{o.status}}</span></td>
<td>
              {% if o.assigned_doctor %}
                <b>{{o.assigned_doctor.full_name or o.assigned_doctor.username}}</b>
              {% else %}
                <span class="badge">UNASSIGNED</span>
              {% endif %}
            </td>
            <td class="actions">
<a class="btn" target="_blank" href="{{pacs_urls[o.id]}}">Open Images</a>

{% if ohif_urls and ohif_urls.get(o.id) %}
<a class="btn primary"
   target="_blank"
   rel="noopener"
   href="{{ohif_urls.get(o.id)}}">
🖥 Open in OHIF
</a>
{% endif %}

<a class="btn primary" href="{{url_for('report_editor',order_id=o.id)}}">Report</a>
            {% if not o.assigned_doctor_id %}
            <form method="post" action="{{url_for('take_case',order_id=o.id)}}" style="display:inline">
              <button class="btn">Take Case</button>
            </form>
            {% endif %}
            <form method="post" action="{{url_for('assign_case',order_id=o.id)}}" class="assign-inline">
              <select name="doctor_user_id"><option value="">Reassign...</option>{% for d in doctors %}<option value="{{d.id}}">{{d.full_name or d.username}}</option>{% endfor %}</select>
              <button class="btn" name="mode" value="manual">Assign</button>
              <button class="btn" name="mode" value="auto">Auto</button>
            </form>
</td>
</tr>
{% else %}<tr><td colspan="6" class="empty">No studies found</td></tr>{% endfor %}
</tbody></table></div></div>
{% endblock %}