server {
    listen 80;
    server_name _;

    client_max_body_size 100m;

    location /dicom-web/ {
        proxy_pass http://radbridge-orthanc:8042/dicom-web/;
        proxy_set_header Authorization "Basic ${ORTHANC_BASIC_AUTH}";
        proxy_set_header Host radbridge-orthanc;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location /radbridge-api/ {
        proxy_pass http://ris-web:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-RadBridge-OHIF-Token "${OHIF_REPORTING_TOKEN}";
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    location /orthanc-api/ {
        proxy_pass http://radbridge-orthanc:8042/;
        proxy_set_header Authorization "Basic ${ORTHANC_BASIC_AUTH}";
        proxy_set_header Host radbridge-orthanc;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://ohif-app:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
