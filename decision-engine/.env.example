# Synthetic local-only placeholders. Copy to .env.local and replace locally.
DECISION_DB_PASSWORD=synthetic-only-change-before-use
JWT_ISSUER=radbridge-development-identity
JWT_AUDIENCE=radbridge-decision-engine
DECISION_ENGINE_PORT=18081
DECISION_PROVIDER=rules
# Optional: auto picks the first enabled provider that also has a server-side API key.
DECISION_PROVIDER_ORDER=jev,openai
JEV_ENABLED=false
JEV_MODEL=jev-latest
# Add JEV_API_KEY only to an approved server-side secret store. Do not commit it.
OPENAI_DECISIONS_ENABLED=false
OPENAI_DECISIONS_MODEL=gpt-6-luna
# Add OPENAI_API_KEY only to an approved server-side secret store. Do not commit it.
